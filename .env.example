VITE_API_URL=http://localhost:3001

# Dynamic contact form: run node app.js (MySQL must be running).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=baha_turk
DB_USER=root
DB_PASSWORD=
HOST=127.0.0.1
PORT=3000

# First-time npm run dev creates a random password if these are unset.
# node app.js defaults to optimized production; npm run dev enables HMR.
# Login details: .env.admin-access.local; password hash: .env.local.
# Production must configure credentials explicitly or retain the local hash.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=
# SECURE_COOKIE=true
# Exact reverse-proxy socket IPs supplied by your host; leave empty for direct access.
TRUSTED_PROXIES=

# Storage warnings only; no automatic deletion or truncation.
RUNTIME_WARN_MB=100
DATABASE_WARN_MB=500
RETIRED_SESSIONS_WARN=100000
WORKSPACE_WARN_MB=1024
MIN_FREE_DISK_MB=512
# Canonical domain and public URL path for this website.
PUBLIC_SITE_URL=https://bahaturk.com
PUBLIC_SITE_PATH=/
